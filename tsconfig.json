{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "preserveSymlinks": true,
    "paths": {
      "~/*": ["./vendor/t3code/apps/web/src/*"],
      "@pierre/words/core": ["./node_modules/@pierre/words/dist/core.d.ts"]
    }
  },
  "include": [
    "src",
    "test"
  ]
}